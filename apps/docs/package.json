{
    "name": "miso-docs",
    "homepage": "https://misojs.dev",
    "private": true,
    "license": "MIT",
    "scripts": {
        "copy:schema": "cp ../miso/miso.schema.json public/miso.schema.json",
        "prebuild": "cp ../miso/miso.schema.json public/miso.schema.json && cp ../../scripts/install.sh public/install.sh",
        "dev": "next dev --port 3000",
        "build": "next build && pagefind --site .next/server/app --output-path public/_pagefind",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@radix-ui/react-tabs": "^1.1.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.563.0",
        "next": "15.5.20",
        "nextra": "4.5.1",
        "nextra-theme-docs": "4.5.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.13",
        "@types/mdx": "^2.0.13",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.6",
        "@types/react-dom": "^19.0.2",
        "autoprefixer": "^10.4.23",
        "pagefind": "^1.3.0",
        "postcss": "^8.5.6",
        "tailwindcss": "3.4.17",
        "typescript": "5.6.3"
    },
    "engines": {
        "node": ">=20.0"
    },
    "packageManager": "yarn@4.2.2+sha512.c44e283c54e02de9d1da8687025b030078c1b9648d2895a65aab8e64225bfb7becba87e1809fc0b4b6778bbd47a1e2ab6ac647de4c5e383a53a7c17db6c3ff4b"
}
