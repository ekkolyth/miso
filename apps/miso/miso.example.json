{
	"$schema": "https://misojs.dev/miso.schema.json",
	"package-manager": "bun",
	"scripts": "./scripts",
	"flags": {
		"install": ["--frozen-lockfile"],
		"dev": ["--env"]
	},
	"env": {
		"path": ".env.local",
		"variables": {
			"PORT": "port",
			"DATABASE_URL": "url",
			"API_KEY": "string"
		}
	}
}
