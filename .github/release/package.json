{
  "name": "miso",
  "version": "0.1.0",
  "description": "the agnostic package manager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekkolyth/miso.git"
  },
  "bin": {
    "miso": "./bin/miso"
  },
  "scripts": {
    "postinstall": "go-npm install",
    "preuninstall": "go-npm uninstall"
  },
  "goBinary": {
    "name": "miso",
    "path": "./bin",
    "url": "https://github.com/ekkolyth/miso/releases/download/v{{version}}/miso_{{version}}_{{platform}}_{{arch}}.tar.gz"
  },
  "dependencies": {
    "go-npm": "^0.1.9"
  }
}

